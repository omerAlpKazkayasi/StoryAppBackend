{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientIds": []
    }
  },
  "RateLimiting": {
    "Auth": {
      "GuestPermitLimit": 30,
      "RefreshPermitLimit": 60,
      "GoogleLoginPermitLimit": 30,
      "GoogleUpgradePermitLimit": 30,
      "WindowMinutes": 1
    }
  }
}
