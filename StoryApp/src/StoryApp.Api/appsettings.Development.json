{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=StoryAppDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "StoryApp",
    "Audience": "StoryApp.Mobile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Authentication": {
    "Google": {
      "ClientIds": [
        "storyapp-google-client-id-dev"
      ]
    }
  },
  "RateLimiting": {
    "Auth": {
      "GuestPermitLimit": 30,
      "RefreshPermitLimit": 60,
      "GoogleLoginPermitLimit": 30,
      "GoogleUpgradePermitLimit": 30,
      "WindowMinutes": 1
    }
  }
}
